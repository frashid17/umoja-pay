# Neon Postgres (pooled connection string from the Neon console)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Neon Auth (Managed Better Auth): enable Auth in the Neon Console, then copy Auth URL
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=your-secret-at-least-32-characters-long

# Comma-separated emails promoted to platform admin on first login
PLATFORM_ADMIN_EMAILS=admin@umoja.dev

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Paystack (test keys for mode=test; live keys for mode=live)
PAYSTACK_SECRET_KEY=sk_test_…
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_…
# PAYSTACK_LIVE_SECRET_KEY=sk_live_…
# NEXT_PUBLIC_PAYSTACK_LIVE_PUBLIC_KEY=pk_live_…
# Set to "sandbox" to force local fake adapters even if Paystack keys exist
# PAYMENTS_PROVIDER=paystack
